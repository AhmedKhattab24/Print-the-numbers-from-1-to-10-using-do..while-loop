    {
      "cell_type": "code",
      "source": [
        " # 2. Dataset Extraction & Paths Setup\n",
        "ZIP_DATASET_PATH = \"/content/archive.zip\"\n",
        "EXTRACT_DIRECTORY_PATH =\"/content/Extract\"\n",
        "\n",
        "# Check if dataset is already extracted\n",
        "if os.path.exists(EXTRACT_DIRECTORY_PATH) and len(os.listdir(EXTRACT_DIRECTORY_PATH)) > 0:\n",
        "    print(f\"Using already extracted dataset folder: {EXTRACT_DIRECTORY_PATH}\")\n",
        "    DATA_DIR = EXTRACT_DIRECTORY_PATH\n",
        "else:\n",
        "    if os.path.exists(ZIP_DATASET_PATH):\n",
        "        print(f\"Extracting {ZIP_DATASET_PATH}...\")\n",
        "        try:\n",
        "            with zipfile.ZipFile(ZIP_DATASET_PATH, 'r') as zip_ref:\n",
        "                zip_ref.extractall(EXTRACT_DIRECTORY_PATH)\n",
        "            DATA_DIR = EXTRACT_DIRECTORY_PATH\n",
        "        except zipfile.BadZipFile as e:\n",
        "            print(f\"Error: The file {ZIP_DATASET_PATH} is corrupted or not a valid ZIP file.\")\n",
        "            raise e\n",
        "    else:\n",
        "        print(f\"{ZIP_DATASET_PATH} not found. Using default directory: {EXTRACT_DIRECTORY_PATH}\")\n",
        "        DATA_DIR = \"/content/Extract\"\n",
        "\n",
        "\"\"\"# **Collect Images, Clean Labels & Remove Duplicates**\"\"\"\n",
        "\n",
        "# توحيد أسماء الكلاسات: الداتا مجمعة من أكتر من مصدر وكل مصدر بيسمي الفولدر بشكل مختلف\n",
        "# لو فولدر ما اتعرفش هيتم تجاهله (STRICT_4_CLASSES = True) ويتطبع اسمه عشان تراجعه\n",
        "STRICT_4_CLASSES = True\n",
        "\n",
        "def normalize_label(folder_name):\n",
        "    name = folder_name.lower().replace('-', '_').replace(' ', '_')\n",
        "    if 'glioma' in name:\n",
        "        return 'glioma'\n",
        "    if 'menin' in name:\n",
        "        return 'meningioma'\n",
        "    if 'pituitary' in name:\n",
        "        return 'pituitary'\n",
        "    if name in ('notumor', 'no_tumor', 'no', 'normal', 'healthy', 'notumour', 'brain_normal'):\n",
        "        return 'no_tumor'\n",
        "    return None\n",
        "\n",
        "def file_md5(path, chunk_size=1 << 20):\n",
        "    h = hashlib.md5()\n",
        "    with open(path, 'rb') as f:\n",
        "        for chunk in iter(lambda: f.read(chunk_size), b''):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "filepaths = []\n",
        "labels = []\n",
        "unmapped_folders = set()\n",
        "\n",
        "valid_extensions = ('.jpg', '.jpeg', '.png', '.bmp', '.tiff')\n",
        "for root, dirs, files in os.walk(DATA_DIR):\n",
        "    for file in files:\n",
        "        if file.lower().endswith(valid_extensions):\n",
        "            folder = os.path.basename(root)\n",
        "\n",
        "            # Skip generic folder names\n",
        "            if folder.lower() in ['testing', 'training', 'extract']:\n",
        "                continue\n",
        "\n",
        "            label = normalize_label(folder)\n",
        "            if label is None:\n",
        "                unmapped_folders.add(folder)\n",
        "                if STRICT_4_CLASSES:\n",
        "                    continue\n",
        "                label = folder\n",
        "\n",
        "            filepaths.append(os.path.join(root, file))\n",
        "            labels.append(label)\n",
        "\n",
        "print(f\"Total images collected: {len(filepaths)}\")\n",
        "if unmapped_folders:\n",
        "    print(f\"Folders not mapped to the 4 classes (check them!): {sorted(unmapped_folders)}\")\n",
        "if len(filepaths) == 0:\n",
        "    print(\"WARNING: No images were found. Please verify that the dataset is extracted correctly.\")\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame({'filepaths': filepaths, 'labels': labels})\n",
        "if df.empty:\n",
        "    raise ValueError(\"The DataFrame is empty. Please check your data directory.\")\n",
        "\n",
        "# حذف الصور المكررة (نفس الملف بالظبط) - التكرار بين التقسيمات بيخلي الدقة وهمية\n",
        "df['hash'] = df['filepaths'].apply(file_md5)\n",
        "\n",
        "# صور مكررة بأكتر من label (تضارب) نحذفها بالكامل\n",
        "label_conflicts = df.groupby('hash')['labels'].nunique()\n",
        "conflicting_hashes = label_conflicts[label_conflicts > 1].index\n",
        "print(f\"Images with conflicting labels removed: {df['hash'].isin(conflicting_hashes).sum()}\")\n",
        "df = df[~df['hash'].isin(conflicting_hashes)]\n",
        "\n",
        "before = len(df)\n",
        "df = df.drop_duplicates(subset='hash').reset_index(drop=True)\n",
        "print(f\"Exact duplicates removed: {before - len(df)} | Remaining images: {len(df)}\")\n",
        "print(df['labels'].value_counts())\n",
        "\n",
        "\"\"\"# **Train / Validation / Test Split**\"\"\"\n",
        "\n",
        "# تقسيم 70% تدريب - 15% validation - 15% اختبار\n",
        "# الـ validation يستخدم للـ callbacks فقط، والـ test للتقييم النهائي مرة واحدة\n",
        "train_df, temp_df = train_test_split(\n",
        "    df,\n",
        "    train_size=0.70,\n",
        "    shuffle=True,\n",
        "    random_state=SEED,\n",
        "    stratify=df['labels']\n",
        ")\n",
        "val_df, test_df = train_test_split(\n",
        "    temp_df,\n",
        "    test_size=0.50,\n",
        "    shuffle=True,\n",
        "    random_state=SEED,\n",
        "    stratify=temp_df['labels']\n",
        ")\n",
        "print(f\"Train: {train_df.shape}, Validation: {val_df.shape}, Test: {test_df.shape}\")\n",
        "\n",
        "\"\"\"# **Data Distribution Visualization**\"\"\"\n",
        "\n",
        "for split_name, split_df in [('Training', train_df), ('Validation', val_df), ('Testing', test_df)]:\n",
        "    plt.figure(figsize=(15, 5))\n",
        "    ax = sns.countplot(data=split_df, y='labels', hue='labels', palette='viridis', legend=False)\n",
        "    plt.title(f'Count of images in each class ({split_name} Data)', fontsize=16)\n",
        "    for container in ax.containers:\n",
        "        ax.bar_label(container)\n",
        "    plt.show()\n",
        "\n",
        "\"\"\"# **Data Generators & Visualization**\"\"\"\n",
        "\n",
        "IMAGE_SIZE = (300, 300)      # الحجم الأصلي لـ EfficientNetB3\n",
        "BATCH_SIZE = 16\n",
        "COLOR_CHANNELS = 3\n",
        "IMAGE_SHAPE = (300, 300, 3)\n",
        "\n",
        "# مهم: EfficientNet فيه preprocessing جوه الموديل وبيتوقع قيم من 0 إلى 255\n",
        "# فلازم نشيل rescale=1./255 (كان بيضعف الـ pretrained features جداً)\n",
        "train_data_generator = ImageDataGenerator(\n",
        "    rotation_range=15,\n",
        "    width_shift_range=0.1,\n",
        "    height_shift_range=0.1,\n",
        "    zoom_range=0.1,\n",
        "    brightness_range=(0.85, 1.15),\n",
        "    horizontal_flip=True,\n",
        "    fill_mode='nearest'\n",
        ")\n",
        "eval_data_generator = ImageDataGenerator()   # بدون augmentation وبدون rescale\n",
        "\n",
        "train_gen = train_data_generator.flow_from_dataframe(\n",
        "    train_df,\n",
        "    x_col='filepaths',\n",
        "    y_col='labels',\n",
        "    target_size=IMAGE_SIZE,\n",
        "    class_mode='categorical',\n",
        "    color_mode='rgb',\n",
        "    shuffle=True,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    seed=SEED\n",
        ")\n",
        "\n",
        "val_gen = eval_data_generator.flow_from_dataframe(\n",
        "    val_df,\n",
        "    x_col='filepaths',\n",
        "    y_col='labels',\n",
        "    target_size=IMAGE_SIZE,\n",
        "    class_mode='categorical',\n",
        "    color_mode='rgb',\n",
        "    shuffle=False,\n",
        "    batch_size=BATCH_SIZE\n",
        ")\n",
        "\n",
        "test_gen = eval_data_generator.flow_from_dataframe(\n",
        "    test_df,\n",
        "    x_col='filepaths',\n",
        "    y_col='labels',\n",
        "    target_size=IMAGE_SIZE,\n",
        "    class_mode='categorical',\n",
        "    color_mode='rgb',\n",
        "    shuffle=False,\n",
        "    batch_size=BATCH_SIZE\n",
        ")\n",
        "\n",
        "# generator للتدريب بدون augmentation عشان تقييم الـ train يبقى عادل\n",
        "train_eval_gen = eval_data_generator.flow_from_dataframe(\n",
        "    train_df,\n",
        "    x_col='filepaths',\n",
        "    y_col='labels',\n",
        "    target_size=IMAGE_SIZE,\n",
        "    class_mode='categorical',\n",
        "    color_mode='rgb',\n",
        "    shuffle=False,\n",
        "    batch_size=BATCH_SIZE\n",
        ")\n",
        "\n",
        "class_dictionary = train_gen.class_indices\n",
        "class_names = list(class_dictionary.keys())\n",
        "number_of_classes = len(class_names)\n",
        "print(\"Classes:\", class_dictionary)\n",
        "\n",
        "# Class weights (لو الداتا غير متوازنة)\n",
        "class_weights_array = compute_class_weight(\n",
        "    class_weight='balanced',\n",
        "    classes=np.unique(train_gen.classes),\n",
        "    y=train_gen.classes\n",
        ")\n",
        "class_weights = dict(enumerate(class_weights_array))\n",
        "print(\"Class weights:\", class_weights)\n",
        "\n",
        "# Display sample images (augmented)\n",
        "sample_images, sample_labels = next(train_gen)\n",
        "plt.figure(figsize=(20, 10))\n",
        "for i in range(min(8, len(sample_images))):\n",
        "    plt.subplot(2, 4, i + 1)\n",
        "    plt.imshow(sample_images[i].astype('uint8'))\n",
        "    sample_class_index = np.argmax(sample_labels[i])\n",
        "    sample_class_name = class_names[sample_class_index]\n",
        "    plt.title(sample_class_name, color='blue', fontsize=12)\n",
        "    plt.axis('off')\n",
        "plt.show()"
      ],
